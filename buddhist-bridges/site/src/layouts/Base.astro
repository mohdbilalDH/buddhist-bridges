---
import '../styles/global.css';
const { title, description = 'Sixteen centuries of Buddhist exchange between India and Korea — 43 documented mediators, five generations, one five-hundred-year silence.', current = '' } = Astro.props;
const nav = [
  ['/', 'Overview', 'home'],
  ['/argument/', 'The Argument', 'argument'],
  ['/timeline/', 'Timeline', 'timeline'],
  ['/people/', 'People', 'people'],
  ['/network/', 'Network', 'network'],
  ['/data/', 'Data & Method', 'data'],
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} · Buddhist Bridges` : 'Buddhist Bridges — India–Korea Buddhist Exchange, 300–2026'}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <meta property="og:title" content={title ?? 'Buddhist Bridges'} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="inner">
      <a class="brand" href={`${base}/`}>Buddhist Bridges</a>
      <nav aria-label="Main">
        {nav.map(([href, label, key]) => (
          <a href={`${base}${href}`} aria-current={key === current ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="inner">
      <p>
        Buddhist Bridges · dataset V3.0 (frozen 2026-08-17) · 43 mediators · 19 events · 187 graded sources ·
        every claim cited to a record ID and source key.
        Built as a static site; the frozen dataset is never modified by the site build.
      </p>
      <p>
        Mohd Bilal Khan · data CC-BY-4.0, code MIT · <a href={`${base}/data/`}>cite this project</a>
      </p>
    </div>
  </footer>
</body>
</html>
